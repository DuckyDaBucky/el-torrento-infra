# Example systemd mount unit for media-ingest (VM 103, 192.168.4.53).
# Only downloads is exported to ingest; library mount must stay absent (CLU verified).

[Unit]
Description=NFS downloads read-write for ingest
After=network-online.target
Wants=network-online.target
Before=docker.service

[Mount]
What=192.168.4.51:/srv/media/downloads
Where=/mnt/media/downloads
Type=nfs4
Options=_netdev,rw,hard,timeo=600,retrans=2,rsize=1048576,wsize=1048576

[Install]
WantedBy=multi-user.target
